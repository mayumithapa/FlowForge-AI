# ============================================================================
# FlowForge AI — shared environment variables
# Copy to .env at the repo root for docker compose, and to backend/.env / worker/.env for local dev.
# ============================================================================

# --- Database -----------------------------------------------------------------
POSTGRES_USER=flowforge
POSTGRES_PASSWORD=flowforge
POSTGRES_DB=flowforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://flowforge:flowforge@postgres:5432/flowforge?schema=public

# --- Redis --------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_DEFAULT_USER=flowforge
RABBITMQ_DEFAULT_PASS=flowforge
RABBITMQ_URL=amqp://flowforge:flowforge@rabbitmq:5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Backend ------------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=4000
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
CORS_ORIGIN=http://localhost:5173

# --- Worker -------------------------------------------------------------------
WORKER_CONCURRENCY=5

# --- AI -----------------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MIN=60

# ─── Email delivery ─────────────────────────────────────────────────────────
# EMAIL_PROVIDER selects the active client: "resend" | "brevo" | "mock".
# If unset, the worker auto-picks based on which key is present
# (resend > brevo > mock).
#
# Resend  (https://resend.com)  — 100 emails/day free. Requires a verified
#                                 domain to send to addresses other than the
#                                 signup email.
# Brevo   (https://www.brevo.com) — 300 emails/day free. Just verify ONE
#                                   sender email; can then send to anyone.
EMAIL_PROVIDER=
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=FlowForge AI <onboarding@resend.dev>

# --- Frontend -----------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:4000
